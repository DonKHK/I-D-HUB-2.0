rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // UID collection - only non-anonymous
    match /UID/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid && !request.auth.token.firebase.sign_in_provider.contains('anonymous');
      allow write: if request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    
    // Projects collection - ALL authenticated users (including PW anonymous) can read AND write
    match /projects/{projectId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Ideas collection - anonymous can CREATE (submit); only non-anonymous can modify
    match /ideas/{ideaId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    
    // Other collections - only email/password users
    match /{document=**} {
      allow read, write: if request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
  }
}