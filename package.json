{
  "name": "pmis",
  "version": "1.0.0",
  "private": true,
  "description": "PMIS - Project Management Information System",
  "scripts": {
    "install:all": "cd backend && npm install && cd ../frontend && npm install && cd ../desktop && npm install",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:frontend": "cd frontend && npm run build",
    "start:desktop": "cd desktop && npm start"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "vite": "^8.1.5"
  },
  "keywords": [
    "pmis",
    "project-management"
  ],
  "license": "ISC"
}
